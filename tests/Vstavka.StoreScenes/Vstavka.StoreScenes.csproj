    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Vstavka.StoreScenes</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vstavka\Vstavka.csproj" />
    <ProjectReference Include="..\..\src\Vstavka.Core\Vstavka.Core.csproj" />
    <Compile Include="..\..\src\Vstavka\Presentation\PreviewSourceIcons.cs" Link="PreviewSourceIcons.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Vstavka.Platform.Linux/Vstavka.Platform.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../gnome-extension/vstavka@xopoko.github.io/**/*"
             Exclude="../../gnome-extension/vstavka@xopoko.github.io/**/gschemas.compiled"
             Link="gnome-extension/vstavka@xopoko.github.io/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

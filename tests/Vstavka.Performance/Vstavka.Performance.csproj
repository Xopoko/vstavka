<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>../../src/Vstavka/app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(VstavkaBinaryRoot)' == ''">
    <ProjectReference Include="../../src/Vstavka/Vstavka.csproj" />
    <ProjectReference Include="../../src/Vstavka.Core/Vstavka.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(VstavkaBinaryRoot)' != ''">
    <Reference Include="Vstavka"><HintPath>$(VstavkaBinaryRoot)/Vstavka.dll</HintPath></Reference>
    <Reference Include="Vstavka.Core"><HintPath>$(VstavkaBinaryRoot)/Vstavka.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>

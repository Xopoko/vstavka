<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Vstavka.Desktop</AssemblyName>
    <Product>Vstavka</Product>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VstavkaWindowsStore)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <ApplicationManifest>Windows.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/Vstavka.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(VstavkaWindowsStore)' == 'true'">
    <AssemblyMetadata Include="VstavkaDistribution" Value="WindowsStore" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../assets/Vstavka.png" Link="Assets/Vstavka.png" />
    <AvaloniaResource Include="../../assets/Vstavka.ico" Link="Assets/Vstavka.ico" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.345" />
    <ProjectReference Include="../Vstavka.Core/Vstavka.Core.csproj" />
    <ProjectReference Include="../Vstavka.Platform/Vstavka.Platform.csproj" />
    <ProjectReference Include="../Vstavka.Platform.Linux/Vstavka.Platform.Linux.csproj" />
    <ProjectReference Include="../Vstavka.Platform.MacOS/Vstavka.Platform.MacOS.csproj" />
    <ProjectReference Include="../Vstavka.Platform.Windows/Vstavka.Platform.Windows.csproj" />
    <InternalsVisibleTo Include="Vstavka.Desktop.Tests" />
  </ItemGroup>
  <!-- The GNOME Shell helper ships only with Linux builds; macOS code signing rejects it inside an app bundle. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('linux'))">
    <Content Include="../../gnome-extension/vstavka@xopoko.github.io/**/*"
             Exclude="../../gnome-extension/vstavka@xopoko.github.io/**/gschemas.compiled"
             Link="gnome-extension/vstavka@xopoko.github.io/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

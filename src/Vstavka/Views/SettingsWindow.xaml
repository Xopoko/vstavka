<Window x:Class="Vstavka.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Vstavka.Localization"
        Title="{loc:Tr Key=Settings}" Width="660" Height="780" MinWidth="600" MinHeight="560" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14" SnapsToDevicePixels="True" AutomationProperties.Name="{loc:Tr Key=Settings}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Vstavka;component/Presentation/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,8">
            <StackPanel>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=Appearance}" Style="{StaticResource SectionLabel}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=Language}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Code" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Tr Key=SelectLanguage}"/>
                        </Grid>
                        <TextBlock Text="{loc:Tr Key=LanguageHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=Theme}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="Appearance_Changed" AutomationProperties.Name="{loc:Tr Key=Theme}">
                                <ComboBoxItem Content="{loc:Tr Key=ThemeSystem}" Tag="system"/><ComboBoxItem Content="{loc:Tr Key=ThemeLight}" Tag="light"/><ComboBoxItem Content="{loc:Tr Key=ThemeDark}" Tag="dark"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=Accent}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <ComboBox x:Name="AccentCombo" Grid.Column="1" SelectionChanged="Appearance_Changed" AutomationProperties.Name="{loc:Tr Key=Accent}">
                                <ComboBoxItem Content="{loc:Tr Key=AccentWindows}" Tag="windows"/><ComboBoxItem Content="{loc:Tr Key=AccentViolet}" Tag="violet"/><ComboBoxItem Content="{loc:Tr Key=AccentBlue}" Tag="blue"/><ComboBoxItem Content="{loc:Tr Key=AccentTeal}" Tag="teal"/><ComboBoxItem Content="{loc:Tr Key=AccentRose}" Tag="rose"/><ComboBoxItem Content="{loc:Tr Key=AccentAmber}" Tag="amber"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=Sound}" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="CopySoundCheck" Style="{StaticResource OptionCheckBox}" AutomationProperties.Name="{loc:Tr Key=CopySound}" Margin="0,7,12,7"><TextBlock Text="{loc:Tr Key=CopySound}" TextWrapping="Wrap"/></CheckBox>
                            <Button Grid.Column="1" Content="{loc:Tr Key=PreviewSound}" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" Click="PreviewCopy_Click" AutomationProperties.Name="{loc:Tr Key=PlayCopySound}"/>
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="PasteSoundCheck" Style="{StaticResource OptionCheckBox}" AutomationProperties.Name="{loc:Tr Key=PasteSound}" Margin="0,7,12,7"><TextBlock Text="{loc:Tr Key=PasteSound}" TextWrapping="Wrap"/></CheckBox>
                            <Button Grid.Column="1" Content="{loc:Tr Key=PreviewSound}" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" Click="PreviewPaste_Click" AutomationProperties.Name="{loc:Tr Key=PlayPasteSound}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=Volume}" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" Margin="0,0,16,0"/>
                            <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" VerticalAlignment="Center" ValueChanged="Volume_Changed" AutomationProperties.Name="{loc:Tr Key=Volume}"/>
                                <TextBlock x:Name="VolumeLabel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=Startup}" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource OptionCheckBox}" AutomationProperties.Name="{loc:Tr Key=StartWithWindows}"><TextBlock Text="{loc:Tr Key=StartWithWindows}" TextWrapping="Wrap"/></CheckBox>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=OpenHistory}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <ComboBox x:Name="HotkeyCombo" Grid.Column="1" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Tr Key=Shortcut}"><ComboBoxItem Content="Ctrl+Shift+V"/><ComboBoxItem Content="Ctrl+Alt+V"/><ComboBoxItem Content="Alt+V"/></ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Key=History}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{loc:Tr Key=PrivacySummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=Retention}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <ComboBox x:Name="RetentionCombo" Grid.Column="1" AutomationProperties.Name="{loc:Tr Key=Retention}"><ComboBoxItem Content="{loc:Tr Key=Days7}" Tag="7"/><ComboBoxItem Content="{loc:Tr Key=Days30}" Tag="30"/><ComboBoxItem Content="{loc:Tr Key=Days90}" Tag="90"/><ComboBoxItem Content="{loc:Tr Key=Year1}" Tag="365"/><ComboBoxItem Content="{loc:Tr Key=Forever}" Tag="0"/></ComboBox>
                        </Grid>
                        <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr Key=MaxItems}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                            <TextBox x:Name="MaxItemsBox" Grid.Column="1" Style="{StaticResource InputBox}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Tr Key=MaxItems}"/>
                        </Grid>
                        <TextBlock Text="{loc:Tr Key=PinnedRetention}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Tr Key=ExcludedApps}" FontSize="14" Margin="0,18,0,8"/>
                        <TextBox x:Name="ExcludedAppsBox" Style="{StaticResource InputBox}" MinLines="3" MaxLines="3" FlowDirection="LeftToRight" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="{loc:Tr Key=ExcludedApps}"/>
                        <TextBlock Text="{loc:Tr Key=ExcludedAppsHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0"/>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <Button x:Name="ClearHistoryButton" Content="{loc:Tr Key=ClearHistory}" HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Click="ClearHistory_Click" AutomationProperties.Name="{loc:Tr Key=ClearHistory}"/>
                                <Border x:Name="ClearConfirmation" Visibility="Collapsed" Background="{DynamicResource DangerSurfaceBrush}" CornerRadius="9" Padding="12" Margin="0,9,0,0">
                                    <StackPanel><TextBlock Text="{loc:Tr Key=ClearConfirmation}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource DangerBrush}"/>
                                        <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="CancelClearButton" Content="{loc:Tr Key=Cancel}" Style="{StaticResource SoftButton}" Click="CancelClear_Click" Margin="0,0,8,0"/><Button x:Name="ConfirmClearButton" Content="{loc:Tr Key=DeleteAll}" Style="{StaticResource DangerFillButton}" Click="ConfirmClear_Click" AutomationProperties.Name="{loc:Tr Key=ConfirmDelete}"/></WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="ClearStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource WindowBrush}" Padding="24,13">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{loc:Tr Key=Cancel}" IsCancel="True" Style="{StaticResource SoftButton}" Padding="17,10" Margin="0,0,9,0"/><Button x:Name="SaveButton" Content="{loc:Tr Key=Save}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="Vstavka.Views.RibbonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Vstavka.Localization"
        xmlns:present="clr-namespace:Vstavka.Presentation"
        Title="{loc:Tr Key=History}" Width="1200" Height="338"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated"
        AutomationProperties.Name="{loc:Tr Key=History}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Vstavka;component/Presentation/Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
            <ContextMenu x:Key="CardMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Uid="paste" Header="{loc:Tr Key=Paste}" InputGestureText="Enter"/>
                <MenuItem Uid="paste-plain" Header="{loc:Tr Key=PastePlain}" InputGestureText="Shift+Enter"/>
                <MenuItem Uid="copy" Header="{loc:Tr Key=Copy}"/>
                <Separator/>
                <MenuItem Uid="pin" Header="{Binding PinTooltip}"/>
                <MenuItem Uid="collection-assignment"/>
                <MenuItem Uid="collection-removal" Header="{loc:Tr Key=RemoveFromCollection}"/>
                <MenuItem Uid="delete" Header="{loc:Tr Key=Delete}" InputGestureText="Delete"/>
            </ContextMenu>
            <Style x:Key="Card" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                <Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="250"/>
                <Setter Property="Height" Value="214"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                <Setter Property="ContextMenu" Value="{StaticResource CardMenu}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="CardSurface" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="SelectionRing" Style="{StaticResource FocusRing}" CornerRadius="14"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource HoverLineBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                            <Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid ClipToBounds="True">
    <Grid x:Name="AnimatedSurface">
        <Grid.RenderTransform><TranslateTransform x:Name="DrawerOffset"/></Grid.RenderTransform>
        <Border CornerRadius="23" Background="{DynamicResource WindowBrush}" Margin="5" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity="0.12" Color="{DynamicResource ShadowColor}"/></Border.Effect>
        </Border>
    <Border x:Name="Drawer" CornerRadius="23" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="5">
        <Grid SizeChanged="Layout_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
            <Grid x:Name="Toolbar" Margin="18,10,14,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid x:Name="CategoriesRail" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="CategoryPrevious" Style="{StaticResource IconButton}" Content="&#xE76B;" Visibility="Collapsed" Click="CategoryPrevious_Click" ToolTip="{loc:Tr Key=PreviousCategories}" AutomationProperties.Name="{loc:Tr Key=PreviousCategories}"/>
                    <ScrollViewer x:Name="CategoryScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewMouseWheel="Categories_MouseWheel" ScrollChanged="Categories_ScrollChanged">
                        <StackPanel x:Name="Chips" Orientation="Horizontal">
                            <Button x:Name="AllChip" Content="{loc:Tr Key=All}" Uid="all" Tag="selected" Style="{StaticResource ChipButton}" Click="Filter_Click"/>
                            <Button Content="{loc:Tr Key=Pinned}" Uid="pinned" Style="{StaticResource ChipButton}" Click="Filter_Click"/>
                            <Button Content="{loc:Tr Key=Text}" Uid="text" Style="{StaticResource ChipButton}" Click="Filter_Click"/>
                            <Button Content="{loc:Tr Key=Links}" Uid="link" Style="{StaticResource ChipButton}" Click="Filter_Click"/>
                            <Button Content="{loc:Tr Key=Images}" Uid="image" Style="{StaticResource ChipButton}" Click="Filter_Click"/>
                            <Button Content="{loc:Tr Key=Files}" Uid="files" Style="{StaticResource ChipButton}" Click="Filter_Click"/>
                            <Border x:Name="CollectionDivider" Width="1" Height="18" VerticalAlignment="Center" Margin="6,0"
                                    Background="{DynamicResource LineBrush}" Visibility="Collapsed"/>
                            <Button x:Name="NewCollectionButton" Style="{StaticResource IconButton}" Content="&#xE710;" Click="NewCollection_Click"
                                    ToolTip="{loc:Tr Key=NewCollection}" AutomationProperties.Name="{loc:Tr Key=NewCollection}" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="CategoryNext" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76C;" Visibility="Collapsed" Click="CategoryNext_Click" ToolTip="{loc:Tr Key=NextCategories}" AutomationProperties.Name="{loc:Tr Key=NextCategories}"/>
                </Grid>
                <Grid x:Name="SearchContainer" Grid.Column="1" Margin="0,0,9,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="33,9,12,9" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{loc:Tr Key=Search}" ToolTip="{loc:Tr Key=Search}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="{loc:Tr Key=Search}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="34,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <StackPanel x:Name="ToolbarActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" Click="Pause_Click" ToolTip="{loc:Tr Key=Pause}" AutomationProperties.Name="{loc:Tr Key=Pause}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="{loc:Tr Key=Settings}" AutomationProperties.Name="{loc:Tr Key=Settings}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{loc:Tr Key=Close}" AutomationProperties.Name="{loc:Tr Key=Close}"/>
                </StackPanel>
            </Grid>            <Grid Grid.Row="1" Margin="18,0,6,0">
                <ListBox x:Name="Cards" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="0,0,0,4" ItemContainerStyle="{StaticResource Card}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionMode="Single" MouseDoubleClick="Cards_DoubleClick" PreviewMouseWheel="Cards_MouseWheel" AutomationProperties.Name="{loc:Tr Key=HistoryItems}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border CornerRadius="10" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
                                <Border Padding="11,0,4,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding TypeBrush}" VerticalAlignment="Center" FontSize="13" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="CardTypeLabel" Grid.Column="1" Text="{Binding TypeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" MinWidth="32" MinHeight="32" VerticalAlignment="Center" FontSize="14" Content="{Binding PinGlyph}" Foreground="{Binding PinBrush}" Click="Pin_Click" ToolTip="{Binding PinTooltip}" AutomationProperties.Name="{Binding PinTooltip}"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" ClipToBounds="True">
                                    <StackPanel Margin="13,12,13,8" Visibility="{Binding IsText, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock x:Name="PayloadText" Text="{Binding Preview}" Foreground="{DynamicResource InkBrush}" FlowDirection="{Binding ContentFlowDirection}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Margin="13,12,13,8" Visibility="{Binding IsLink, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding Domain}" FlowDirection="LeftToRight" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FlowDirection="LeftToRight" Margin="0,8,0,0" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Margin="7" CornerRadius="7" Background="{DynamicResource MediaBrush}" ClipToBounds="True" Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}"><Image Source="{Binding Image}" Stretch="Uniform" AutomationProperties.Name="{Binding Title}"/></Border>
                                    <Grid Margin="9" Visibility="{Binding IsColor, Converter={StaticResource BoolVisibility}}">
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
                                        <Border Background="{Binding Swatch}" CornerRadius="7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
                                        <TextBlock x:Name="ColorValueLabel" Grid.Row="1" Text="{Binding ColorText}" Foreground="{DynamicResource InkBrush}" FlowDirection="LeftToRight" FontFamily="Cascadia Code, Consolas" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
                                    </Grid>
                                    <StackPanel Margin="13,12,13,8" Visibility="{Binding IsFiles, Converter={StaticResource BoolVisibility}}">
                                        <ItemsControl ItemsSource="{Binding FileNames}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/><TextBlock x:Name="FileNameLabel" Text="{Binding}" Foreground="{DynamicResource InkBrush}" FlowDirection="LeftToRight" FontSize="14" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="10,0" Padding="1,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <present:DecorativeImage x:Name="SourceIconImage" Source="{Binding SourceIcon}" Width="16" Height="16"
                                                                 FlowDirection="LeftToRight" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <present:DecorativeGlyph x:Name="SourceIconFallback" Text="&#xECAA;"
                                                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                                 Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="CardSourceLabel" Grid.Column="2" Text="{Binding Source}" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding SourceIcon}" Value="{x:Null}">
                                <Setter TargetName="SourceIconImage" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SourceIconFallback" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid x:Name="EmptyState" Visibility="Collapsed" Margin="0,0,12,12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
                        <Border Width="51" Height="51" Background="{DynamicResource SelectionBrush}" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,13"><TextBlock x:Name="EmptyGlyph" Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource SelectionForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock x:Name="EmptyTitle" Text="{loc:Tr Key=EmptyHistory}" TextAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EmptyDescription" Text="{loc:Tr Key=EmptyHistoryHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountLabel" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    <StackPanel x:Name="KeyboardHints" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" ClipToBounds="True"/>
                    <DockPanel x:Name="StatusPanel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="340" Margin="16,0,0,0">
                        <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusLabel" Text="{loc:Tr Key=LocalHistory}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                </Grid>
            </Border>        </Grid>
    </Border>
    </Grid>
    <Popup x:Name="CollectionPopup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False" Focusable="False"
           Opened="CollectionPopup_Opened" Closed="CollectionPopup_Closed">
        <Border x:Name="CollectionPopupSurface" Style="{StaticResource MenuSurface}" Width="328" Padding="16"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                PreviewKeyDown="CollectionPopup_PreviewKeyDown">
            <StackPanel>
                <StackPanel x:Name="CollectionEditor">
                    <Grid>
                        <TextBox x:Name="CollectionNameBox" Style="{StaticResource InputBox}" AutomationProperties.Name="{loc:Tr Key=CollectionName}"
                                 TextChanged="CollectionName_TextChanged"/>
                        <TextBlock x:Name="CollectionNamePlaceholder" Text="{loc:Tr Key=CollectionName}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                   Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <TextBlock x:Name="CollectionError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                               Margin="0,6,0,0" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel x:Name="CollectionSwatches" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,8,0,0" KeyboardNavigation.TabNavigation="Once"/>
                </StackPanel>
                <TextBlock x:Name="CollectionDeleteMessage" TextWrapping="Wrap" FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CollectionCancel" Style="{StaticResource SoftButton}" Content="{loc:Tr Key=Cancel}"
                            Margin="0,0,8,0" Click="CollectionCancel_Click"/>
                    <Button x:Name="CollectionSubmit" Click="CollectionSubmit_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
